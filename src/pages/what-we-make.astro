---
import Factory from '../layouts/Factory.astro';
import MakeHero from '../components/factory/make/MakeHero.astro';
import MakeSheet from '../components/factory/make/MakeSheet.astro';
import MakeClose from '../components/factory/make/MakeClose.astro';
import { CLIENTS } from '../data/clients';

const live = CLIENTS.filter((c) => !c.archived);
const ACCENTS = ['var(--cobalt)', 'var(--teal)', 'var(--coral)'];
---

<Factory
	title="What we make | a6n"
	description="Spec sheets for the systems a6n built for real businesses: what each one does, who uses it and where it runs."
	current="make"
>
	<MakeHero clients={live} />
	<section class="make-sheets" aria-label="Spec sheets">
		{live.map((c, i) => (
			<MakeSheet client={c} n={i + 1} total={live.length} accent={ACCENTS[i % ACCENTS.length]} />
		))}
	</section>
	<MakeClose />
</Factory>

<script>
	import '../scripts/factory/page-make';
</script>
