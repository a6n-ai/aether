---
import Factory from '../../layouts/Factory.astro';
import DotType from '../../components/factory/DotType.astro';
import { CLIENTS, type Client } from '../../data/clients';
import { BOOK_CALL_HREF } from '../../lib/cta';

export function getStaticPaths() {
	const ACCENTS = ['cobalt', 'coral', 'teal', 'lilac'];
	return CLIENTS.map((client, i) => ({
		params: { slug: client.slug },
		props: { client, next: CLIENTS[(i + 1) % CLIENTS.length], accent: ACCENTS[i % ACCENTS.length] },
	}));
}

const { client, next, accent } = Astro.props as { client: Client; next: Client; accent: string };
---

<Factory title={`${client.name}: ${client.kind}, built by a6n`} description={`${client.intro} Built by a6n.`} current="client">
	<section class="case-hero" style={`--c:var(--${accent})`}>
		<p class="kicker"><b>Client</b> {client.kind}, {client.where}</p>
		<div class="case-title">
			<h1><span class="vh">{client.name}</span><DotType text={client.name} class="case-name" /></h1>
			{client.archived && <span class="archived">Archived</span>}
		</div>
		<p class="case-line">{client.line}</p>
		<p class="case-actions">
			{client.url && <a class="go" href={client.url}>See it live</a>}
			<a class="case-call" href={BOOK_CALL_HREF}>Book a call</a>
		</p>
	</section>
	<section class="case-section" aria-labelledby="need-h">
		<h2 id="need-h">What they needed</h2>
		<p class="case-intro">{client.intro}</p>
	</section>
	<section class="case-section" aria-labelledby="built-h">
		<h2 id="built-h">What we built</h2>
		<div class="case-parts" style={`--c:var(--${accent})`}>
			{
				client.features.map((group) => (
					<div class="tile case-part">
						<h3>{group.title}</h3>
						<ul>
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>
	<nav class="case-next" aria-label="Next client">
		<a href={`/clients/${next.slug}/`}>
			<span class="kicker">Next client</span>
			<span class="case-next-name">{next.name} &rarr;</span>
		</a>
	</nav>
</Factory>

<script>
	import '../../scripts/factory/clientcase';
</script>
