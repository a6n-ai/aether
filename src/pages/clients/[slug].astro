---
import Layout from '../../layouts/Layout.astro';
import Stop from '../../components/Stop.astro';
import { CLIENTS, type Client } from '../../data/clients';
import { STILLS } from '../../data/world';
import { BOOK_CALL_HREF } from '../../lib/cta';

export function getStaticPaths() {
	return CLIENTS.map((client) => ({ params: { slug: client.slug }, props: { client } }));
}

// Each client is its workshop on the sheet: the camera flies to it, and its story rides beside it.
const { client } = Astro.props as { client: Client };
---

<Layout title={`${client.name}: ${client.kind}, built by a6n`} description={`${client.intro} Built by a6n.`}>
	<div class="journey" data-journey>
		<Stop id={client.slug} side="right" heading={client.name} still={STILLS[`workshop-${client.slug}`]} stillAlt={`A drafting sheet of ${client.name}'s system, step by step.`} first long>
			<p class="kind">{client.kind}, {client.where}</p>
			<p>{client.intro}</p>
			<p>{client.line}</p>
			{
				client.features.map((group) => (
					<div class="group">
						<h3>{group.title}</h3>
						<ul>
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</div>
				))
			}
			<p class="actions">
				<a class="btn-call" href={BOOK_CALL_HREF}>Book a call</a>
				<a class="back" href="/">Back to the sheet</a>
			</p>
		</Stop>
	</div>
</Layout>

<style>
	.kind {
		color: var(--muted);
		font-size: var(--t-xs);
	}
	.group h3 {
		font: 500 1.05rem/1.2 var(--font-display);
		color: var(--sanguine-ink);
		margin-bottom: 4px;
	}
	.group ul {
		margin: 0;
		padding-left: 1.1em;
		display: grid;
		gap: 4px;
		color: var(--strong);
		font-size: 0.95rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
	}
	.back {
		color: var(--strong);
	}
</style>
