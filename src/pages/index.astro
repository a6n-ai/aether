---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Stop from '../components/Stop.astro';
import { STILLS } from '../data/world';
import { FAQ } from '../data/faq';
import { BOOK_CALL_HREF } from '../lib/cta';
import relaySite from '../assets/product/relay-site.png';
import relayPhone from '../assets/product/relay-site-phone.png';
import copperSite from '../assets/product/copper-site.png';
import copperPhone from '../assets/product/copper-site-phone.png';
import tiffinSite from '../assets/product/tiffingrab-site.png';
import xplorersSite from '../assets/product/xplorers-site.png';

// Our own products: built and run by us, and any business can use them.
const PRODUCTS = [
	{
		id: 'relay',
		name: 'Relay',
		line: 'One send, every channel. Email, texts, WhatsApp and in-app messages from one place, with every delivery on record.',
		site: relaySite,
		phone: relayPhone,
		href: 'https://relay.a6n.ai',
		alt: "Relay's front page: one send, every channel, with its console listing sent messages and their delivery.",
	},
	{
		id: 'copper',
		name: 'Copper + Cloves',
		line: 'Our own wellness cafés in Bangalore, with meal subscriptions, run end to end on the system we build for you.',
		site: copperSite,
		phone: copperPhone,
		href: 'https://copperandcloves.com',
		alt: "Copper + Cloves' front page: wellness, made simple, over a photograph of the café.",
	},
];
// Businesses we've built for, with their live sites.
const WORK = [
	{ slug: 'tiffingrab', name: 'TiffinGrab', kind: 'Meal plans, delivered, in Toronto', shot: tiffinSite, alt: "TiffinGrab's front page: home-style tiffins, delivered fresh." },
	{ slug: 'xplorers', name: 'Xplorers', kind: "Kids' science classes in Singapore", shot: xplorersSite, alt: "Xplorers' front page: a space to be you, a place to grow." },
];
const shotProps = { formats: ['avif', 'webp'], widths: [480, 900, 1400], sizes: '(max-width: 767px) 92vw, 40vw', loading: 'lazy' } as const;
---

<Layout
	title="a6n · (Ai)ny Management System: built for businesses like yours"
	description="We build the website and app your business runs on: orders, bookings, payments and messages, all in one place. You keep doing the work you love."
>
	<Hero />
	<div class="journey" data-journey>
		<Stop id="bench" side="center" heading="One system for the everyday work of your business." still={STILLS.bench} stillAlt="A drafting sheet: a phone, a laptop, a till and a card terminal on one bench, each cabled to one hub." first home statement>
			<p>Your website, your customers' app, payments, messages, the screen your staff use and your reports: joined into one, shaped around how you already work.</p>
		</Stop>
		<Stop id="shop" side="center" heading="A small team in Singapore and India, working like your own." still={STILLS.shop} stillAlt="A chalk drawing: a shop, our bench inside its window, a spanner fixing something on the spot, two people side by side." statement>
			<p>The same people build your system and look after it, every week.</p>
		</Stop>
		<Stop id="street" side="left" heading="We:" still={STILLS['street-new']} stillAlt="Three chalk shops on one street: a kiosk being built, old papers weighed over into an app, the kiosk a year on with a new wing." href="/how-it-works/" linkText="How a build works">
			<ul class="we">
				<li>Build something new: we draw your idea up and build it from parts that already work.</li>
				<li>Move you over from paper and spreadsheets, with nothing lost.</li>
				<li>Run and grow it: we keep watch every day and add what you need next.</li>
			</ul>
		</Stop>
		{
			PRODUCTS.map((p, i) => (
				<Stop id={p.id} side={i === 0 ? 'left' : 'right'} heading={i === 0 ? 'Our own products. Any business can use them.' : p.name} wide>
					{i === 0 && <p class="kicker">{p.name}</p>}
					<p>{p.line}</p>
					<figure class="shots">
						<Picture src={p.site} {...shotProps} alt={p.alt} class="site" />
						<Picture src={p.phone} {...shotProps} sizes="(max-width: 767px) 30vw, 10vw" alt="" class="phone" />
					</figure>
					<a class="go" href={p.href}>Visit {p.name}</a>
				</Stop>
			))
		}
		<Stop id="work" side="right" heading="Work delivered for" wide>
			<ul class="work">
				{
					WORK.map((w) => (
						<li>
							<a href={`/clients/${w.slug}/`}>
								<Picture src={w.shot} {...shotProps} sizes="(max-width: 767px) 92vw, 20vw" alt={w.alt} />
								<span class="name">{w.name}</span>
								<span class="kind">{w.kind}</span>
							</a>
						</li>
					))
				}
			</ul>
		</Stop>
		<Stop id="notes" side="right" heading="Questions" long href="/how-it-works/#questions" linkText="All questions">
			<div class="faq">
				{
					FAQ.slice(0, 6).map((n, k) => (
						<details>
							<summary><span class="n">{String(k + 1).padStart(2, '0')}</span>{n.q}</summary>
							<p>{n.a}</p>
						</details>
					))
				}
			</div>
		</Stop>
		<Stop id="finale" side="right" heading="Tell us about your business." still={STILLS.whole} stillAlt="The whole sheet, complete: the bench, the shop, the street, the post, the road and the workshops drawn around Leonardo's Vitruvian Man, joined by red chalk lines.">
			<p>One short call: no jargon, no pressure, and an honest answer about whether we can help.</p>
			<p><a class="btn-call" href={BOOK_CALL_HREF}>Book a call</a></p>
		</Stop>
	</div>
</Layout>

<style>
	.we {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
	}
	.we li {
		padding: 14px 0;
		border-top: 1px solid var(--faint);
		color: var(--strong);
	}
	.kicker {
		font: italic 400 1.2rem/1 var(--font-display);
		color: var(--sanguine-ink);
	}
	.shots {
		position: relative;
		margin: 4px 0 8px;
		padding-right: 18%;
	}
	.shots :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 8px;
		box-shadow: 0 14px 40px -18px color-mix(in oklab, var(--strong) 50%, transparent);
	}
	.shots :global(.phone) {
		position: absolute;
		right: 0;
		bottom: -12px;
		width: 24%;
		border-radius: 14px;
	}
	.work {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.work a {
		display: grid;
		gap: 6px;
		color: var(--strong);
		text-decoration: none;
	}
	.work :global(img) {
		width: 100%;
		height: auto;
		border-radius: 6px;
		box-shadow: 0 10px 30px -16px color-mix(in oklab, var(--strong) 50%, transparent);
		transition: translate 300ms var(--ease);
	}
	@media (hover: hover) {
		.work a:hover :global(img) {
			translate: 0 -4px;
		}
	}
	.work a:focus-visible :global(img) {
		translate: 0 -4px;
	}
	.work .name {
		font: 500 1.15rem/1.1 var(--font-display);
	}
	.work .kind {
		color: var(--muted);
		font-size: var(--t-xs);
	}
	.faq details {
		border-top: 1px solid var(--faint);
		padding: 12px 0;
	}
	.faq summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		gap: 14px;
		color: var(--strong);
	}
	.faq summary::-webkit-details-marker {
		display: none;
	}
	.faq summary:focus-visible {
		outline: 2px solid var(--sanguine);
		outline-offset: 2px;
	}
	.faq .n {
		color: var(--muted);
		font-size: var(--t-xs);
		padding-top: 3px;
	}
	.faq details p {
		margin: 8px 0 0 30px;
		font-size: 0.95rem;
		color: var(--text);
	}
	@media (max-width: 767px) {
		.work {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
