---
import Layout from '../layouts/Layout.astro';
import DayStrip from '../components/comic/DayStrip.astro';
import GlobeStrip from '../components/comic/GlobeStrip.astro';
import HowStrip from '../components/comic/HowStrip.astro';
import MailStrip from '../components/comic/MailStrip.astro';
import Mark from '../components/Mark.astro';
import WorldStrip from '../components/comic/WorldStrip.astro';
---

<Layout>
	<a class="skip" href="#top">Skip to story</a>

	<div class="sheet">
		<div class="frame" aria-hidden="true"></div>

		<header class="bar">
			<a class="mark" href="#top">
				<Mark animated />
				<span>A6N</span>
			</a>
			<nav class="bar-nav" aria-label="On this page">
				<a href="#top">Home</a>
				<a href="#how">How</a>
				<a href="#world">World</a>
				<a href="#write">Write</a>
			</nav>
			<div class="bar-actions">
				<button
					class="ghost bar-theme"
					data-theme-toggle
					type="button"
					aria-pressed="false"
				>
					Whiteprint
				</button>
				<a class="solid bar-mail" href="mailto:hi@a6n.ai">hi@a6n.ai</a>
				<button class="menu" id="menu-toggle" type="button" aria-expanded="false" aria-controls="index">
					<span></span>
					<span></span>
					Menu
				</button>
			</div>
		</header>

		<div class="index" id="index" aria-hidden="true">
			<button class="index-close" id="menu-close" type="button">Close</button>
			<nav class="index-grid" aria-label="Menu">
				<a href="#top" data-close>Home</a>
				<a href="#how" data-close>How it helps</a>
				<a href="#world" data-close>All over the world</a>
				<a href="#write" data-close>Write us</a>
				<a class="index-mail" href="mailto:hi@a6n.ai" data-close>hi@a6n.ai</a>
			</nav>
			<button class="ghost index-theme" data-theme-toggle type="button" aria-pressed="false">
				Whiteprint
			</button>
		</div>

		<main>
			<section class="cover" id="top">
				<div class="cover-copy">
					<p class="eyebrow">any management system</p>
					<h1>
						<span class="ai">(Ai)</span>ny
					</h1>
					<p class="product">Management System</p>
					<p class="lede">
						Blueprints to success for any business. Your people, your day — online or on the floor. We act
						like small gears in your machine to make everything smoother.
					</p>
					<a class="solid cover-write" href="mailto:hi@a6n.ai">Write hi@a6n.ai</a>
				</div>
				<DayStrip />
			</section>

			<section class="block" id="how" data-reveal>
				<div class="copy">
					<h2>Not extra tools. The work you already have.</h2>
					<p class="lede">
						Running a business is a lot of little jobs. Operations, attendance, clients, team, customers —
						any management. a6n keeps them on one plan. AI sits on that plan with you. It does not replace
						your judgment.
					</p>
				</div>
				<HowStrip />
			</section>

			<section class="block" id="world" data-reveal>
				<div class="copy">
					<h2>If you run a business, this is for you.</h2>
					<p class="lede">
						A shop, a clinic, a studio, an office — the jobs rhyme. Lean, fast-forward, future-ready. Same
						kind of plan, drawn around the work you already do. Not a system built for one trade, or one
						city.
					</p>
				</div>
				<WorldStrip />
				<div class="globe-follow">
					<GlobeStrip />
				</div>
			</section>

			<section class="block" id="write" data-reveal>
				<div class="copy">
					<h2>Start with what you already do.</h2>
					<p class="lede">Bring the business you have. Write us from anywhere. We read every letter.</p>
				</div>
				<MailStrip />
			</section>
		</main>

		<footer class="colophon">
			<div class="colophon-world">
				<p>All over the world</p>
				<p>a6n is drawn for work on every meridian — same plan, local day.</p>
			</div>
			<div class="colophon-links">
				<a href="mailto:hi@a6n.ai">hi@a6n.ai</a>
				<a href="https://github.com/a6n-ai">GitHub</a>
			</div>
			<div class="stamp">
				<div>
					<small>System</small>
					<strong>(Ai)ny</strong>
				</div>
				<div>
					<small>For</small>
					<strong>Any business</strong>
				</div>
				<div>
					<small>Write</small>
					<strong>hi@a6n.ai</strong>
				</div>
			</div>
		</footer>
	</div>
</Layout>

<script>
	import { initMenu } from '../scripts/menu';
	import { initScroll } from '../scripts/scroll';

	const root = document.documentElement;
	const themeBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')];

	function setTheme(mode: 'cyanotype' | 'whiteprint') {
		if (mode === 'whiteprint') root.dataset.theme = 'whiteprint';
		else delete root.dataset.theme;
		const label = mode === 'cyanotype' ? 'Whiteprint' : 'Cyanotype';
		themeBtns.forEach((btn) => {
			btn.textContent = label;
			btn.setAttribute('aria-pressed', String(mode === 'whiteprint'));
		});
	}

	setTheme('cyanotype');
	themeBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			setTheme(root.dataset.theme === 'whiteprint' ? 'cyanotype' : 'whiteprint');
		});
	});

	initMenu();
	initScroll();
</script>

<style>
	.skip {
		position: absolute;
		left: max(16px, env(safe-area-inset-left, 0px));
		top: -64px;
		z-index: 80;
		min-height: 44px;
		padding: 12px 14px;
		background: var(--ink);
		color: var(--paper);
		font-size: 13px;
	}
	.skip:focus {
		top: max(12px, env(safe-area-inset-top, 0px));
	}

	.sheet {
		position: relative;
		min-height: 100dvh;
		overflow-x: clip;
		background-color: var(--paper);
		background-image:
			linear-gradient(var(--grid) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid) 1px, transparent 1px);
		background-size: 32px 32px;
		color: var(--ink);
		padding: max(8px, env(safe-area-inset-top, 0px)) max(8px, env(safe-area-inset-right, 0px))
			max(8px, env(safe-area-inset-bottom, 0px)) max(8px, env(safe-area-inset-left, 0px));
	}

	.frame {
		pointer-events: none;
		position: fixed;
		inset: 0;
		z-index: 1;
		border: 1px solid var(--line);
	}

	.bar {
		position: sticky;
		top: max(8px, env(safe-area-inset-top, 0px));
		z-index: 50;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		column-gap: 12px;
		min-height: 56px;
		margin: 0;
		padding: 0 8px 0 12px;
		border: 1px solid var(--line-soft);
		background: color-mix(in srgb, var(--paper) 88%, transparent);
		backdrop-filter: blur(18px) saturate(140%);
	}

	.mark {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		min-width: 44px;
		font-family: var(--display);
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
		line-height: 1;
	}

	.bar-nav {
		display: none;
		justify-self: center;
		gap: 8px;
	}
	.bar-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0 8px;
		color: var(--ink-dim);
		text-decoration: none;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.bar-actions {
		display: flex;
		justify-self: end;
		align-items: center;
		gap: 8px;
	}

	.ghost,
	.solid,
	.menu,
	.index-close {
		min-height: 44px;
		padding: 0 14px;
		border: 1px solid var(--line);
		background: transparent;
		color: var(--ink);
		font: 500 12px/1 var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		cursor: pointer;
		transition:
			transform 140ms var(--ease),
			background-color 180ms var(--ease);
	}
	.solid {
		background: var(--ink);
		color: var(--paper);
		border-color: var(--ink);
	}
	.bar-theme,
	.bar-mail {
		display: none;
	}
	.ghost:active,
	.solid:active,
	.menu:active,
	.index-close:active,
	.mark:active {
		transform: scale(0.96);
	}
	.menu {
		padding: 0 12px;
	}
	.menu span {
		display: block;
		width: 14px;
		height: 1px;
		background: currentColor;
	}

	.index {
		position: fixed;
		inset: 0;
		z-index: 90;
		display: none;
		flex-direction: column;
		padding: max(16px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px))
			max(24px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
		background: var(--paper);
		overflow: auto;
		overscroll-behavior: contain;
	}
	.index-close {
		align-self: flex-end;
		margin-bottom: 24px;
	}
	.index-grid {
		display: flex;
		flex-direction: column;
		gap: 4px;
		max-width: 640px;
	}
	.index-grid a {
		display: flex;
		align-items: center;
		min-height: 44px;
		padding: 12px 0;
		color: var(--ink);
		text-decoration: none;
		font-family: var(--display);
		font-size: clamp(28px, 8vw, 56px);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}
	.index-theme {
		margin-top: auto;
		align-self: flex-start;
	}

	main {
		position: relative;
		z-index: 2;
		max-width: 1120px;
		margin: 0 auto;
		padding: 20px 8px 40px;
	}

	.cover {
		padding: 20px 0 36px;
	}
	.cover-copy {
		max-width: 40rem;
		margin-bottom: 28px;
	}
	.cover-write {
		margin-top: 20px;
		width: max-content;
		max-width: 100%;
	}
	.eyebrow,
	.product {
		margin: 0;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-dim);
	}
	h1 {
		margin: 8px 0 0;
		font-family: var(--display);
		font-size: clamp(2.75rem, 16vw, 7.5rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
		text-wrap: balance;
	}
	.product {
		margin: 8px 0 16px;
		font-family: var(--display);
		font-size: clamp(1.25rem, 5vw, 2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink);
	}
	h2 {
		margin: 0 0 12px;
		font-family: var(--display);
		font-size: clamp(1.75rem, 7vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.15;
		text-wrap: balance;
	}
	.lede {
		max-width: 38rem;
		margin: 0;
		text-wrap: pretty;
	}
	.copy {
		margin-bottom: 24px;
	}
	.globe-follow {
		margin-top: 32px;
	}

	.block {
		padding: 48px 0;
		border-top: 1px solid var(--line-soft);
	}

	.colophon {
		position: relative;
		z-index: 2;
		max-width: 1120px;
		margin: 0 auto;
		padding: 28px 8px 36px;
		border-top: 1px solid var(--line);
	}
	.colophon-world p:first-child {
		margin: 0 0 6px;
		font-family: var(--display);
		font-size: clamp(1.75rem, 7vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.colophon-world p:last-child {
		margin: 0 0 20px;
		max-width: 36rem;
		color: var(--ink-dim);
	}
	.colophon-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin-bottom: 24px;
	}
	.colophon-links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--ink);
		font-family: var(--mono);
		letter-spacing: 0.08em;
	}
	.stamp {
		display: grid;
		grid-template-columns: 1fr;
		border: 1px solid var(--line);
	}
	.stamp div {
		padding: 12px 16px;
		border-bottom: 1px solid var(--line-soft);
	}
	.stamp div:last-child {
		border-bottom: 0;
	}
	.stamp small {
		display: block;
		font-family: var(--mono);
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-dim);
	}
	.stamp strong {
		font-family: var(--display);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	@media (hover: hover) and (pointer: fine) {
		.bar-nav a:hover {
			color: var(--ink);
		}
		.ghost:hover,
		.menu:hover,
		.index-close:hover {
			background: color-mix(in srgb, var(--ink) 8%, transparent);
		}
		.index-grid a:hover {
			color: var(--ink-dim);
		}
	}

	@media (min-width: 880px) {
		.sheet {
			padding: 16px;
		}
		.frame {
			inset: 8px;
			box-shadow:
				inset 0 0 0 6px var(--paper),
				inset 0 0 0 7px var(--line-soft);
		}
		.bar {
			grid-template-columns: 1fr auto 1fr;
			column-gap: 16px;
			min-height: 64px;
			margin: 8px 8px 0;
			padding: 0 16px;
			top: 16px;
			background: color-mix(in srgb, var(--paper) 80%, transparent);
		}
		.mark {
			gap: 10px;
			font-size: 28px;
		}
		.bar-nav {
			display: flex;
		}
		.bar-theme,
		.bar-mail {
			display: inline-flex;
		}
		.cover-write,
		.index-theme {
			display: none;
		}
		.index {
			inset: 10px;
			border: 1px solid var(--line);
			padding: 24px 28px 40px;
		}
		.menu {
			padding: 0 14px;
		}
		main,
		.colophon {
			padding-right: 48px;
			padding-left: 48px;
		}
		main {
			padding-top: 32px;
			padding-bottom: 48px;
		}
		.cover {
			padding: 32px 0 48px;
		}
		.block {
			padding: 64px 0;
		}
		.globe-follow {
			margin-top: 40px;
		}
		.stamp {
			grid-template-columns: repeat(3, 1fr);
		}
		.stamp div {
			border-bottom: 0;
			border-right: 1px solid var(--line-soft);
		}
		.stamp div:last-child {
			border-right: 0;
		}
	}

	@media (max-height: 480px) and (orientation: landscape) {
		.cover {
			padding: 12px 0 24px;
		}
		h1 {
			font-size: clamp(2.25rem, 12vh, 4rem);
		}
		.bar {
			min-height: 48px;
		}
	}

	@media (prefers-reduced-transparency: reduce) {
		.bar,
		.index {
			background: var(--paper);
			backdrop-filter: none;
		}
	}
</style>
