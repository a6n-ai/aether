---
import Factory from '../layouts/Factory.astro';
import DotType from '../components/factory/DotType.astro';
import { FAQ } from '../data/faq';
import { BOOK_CALL_HREF } from '../lib/cta';

const STEPS = [
	{ title: 'Conversation', body: "A short call about how your business works today, what's slow, and what you wish your customers could do on their own.", c: 'lilac' },
	{ title: 'Plan', body: 'We write down, in plain words, what we will build first, and show you how it will look before anything is built.', c: 'cobalt' },
	{ title: 'Build', body: 'Sign-in, dashboards, AI assistants, reports and notifications are parts already running inside other businesses. We fit them to yours and build only what is new.', c: 'coral' },
	{ title: 'Launch', body: 'We move your customers and records across, train your staff, and open it to your customers.', c: 'teal' },
	{ title: 'Grow', body: 'We keep watch, fix what breaks and add what you need next. Same team, every week.', c: 'butter' },
];

const faqLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: FAQ.map((n) => ({ '@type': 'Question', name: n.q, acceptedAnswer: { '@type': 'Answer', text: n.a } })),
};
---

<Factory
	title="How it works: from first call to an app your business runs on | a6n"
	description="Every a6n project follows the same path: a conversation, a plan, a build from parts that already work, a launch, and then we keep it running."
	current="how"
>
	<section class="how-hero">
		<p class="kicker"><b>The path</b></p>
		<h1>How it works</h1>
		<p class="how-lead">Every a6n project follows the same path: a conversation, a plan, a build from parts that already work, a launch, and then we keep it running.</p>
	</section>
	<ol class="steps">
		{STEPS.map((s, i) => (
			<li class="step" style={`--c:var(--${s.c})`}>
				<DotType text={String(i + 1)} class="step-no" />
				<div>
					<h2>{s.title}.</h2>
					<p>{s.body}</p>
				</div>
			</li>
		))}
	</ol>
	<section class="how-faq" aria-labelledby="faq-h">
		<h2 id="faq-h">Questions owners ask.</h2>
		{FAQ.map((n) => (
			<details>
				<summary>{n.q}</summary>
				<p>{n.a}</p>
			</details>
		))}
	</section>
	<section class="how-close" aria-labelledby="close-h">
		<h2 id="close-h">Tell us what you need.</h2>
		<p class="how-actions">
			<a class="go" href="/#talk">Tell us what you need</a>
			<a class="how-call" href={BOOK_CALL_HREF}>Book a call</a>
		</p>
	</section>
	<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Factory>

<script>
	import '../scripts/factory/howitworks';
</script>
