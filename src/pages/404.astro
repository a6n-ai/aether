---
import Factory from '../layouts/Factory.astro';
import DotType from '../components/factory/DotType.astro';
---

<Factory title="Out of reach | a6n" description="This page doesn't exist. Head back to the a6n home page, or see what the software factory has built.">
	<section class="nf">
		<DotType text="404" class="nf-code" />
		<h1>This page is just out of reach.</h1>
		<p class="nf-lead">The link you followed doesn't lead anywhere. Everything else is one step back.</p>
		<p class="nf-actions">
			<a class="go" href="/">Back to the front</a>
			<a class="nf-link" href="/showcase">See the Showcase</a>
		</p>
	</section>
</Factory>

<script>
	import '../scripts/factory/notfound';
</script>
