---
import Plate from '../../components/Plate.astro';

---

<section class="workshop" data-reveal>
	<div class="wrap">
		<Plate
			name="workbench"
			fig="Plate IV"
			title="The workshop"
			caption="We don't start from a blank page. Your app is put together from parts already running for other businesses, then shaped around yours."
		/>
	</div>
</section>

<style>
	.workshop {
		padding-block: 88px;
	}
	@media (max-width: 560px) {
		.workshop {
			padding-block: 56px;
		}
	}
</style>
