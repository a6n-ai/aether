---
import { CLIENTS } from '../data/clients';
---

<section class="clients" id="clients" data-section="clients" data-reveal>
	<div class="wrap">
		<h2>Businesses we've already built for.</h2>
		<ul>
			{
				CLIENTS.map((c) => (
					<li style={`--pigment:${c.pigment}`} data-reveal-item>
						<a href={`/clients/${c.slug}/`}>
							<span class="swatch" aria-hidden="true" />
							<h3>{c.name}</h3>
							<p class="kind">
								{c.kind}
								<span class="mono">{c.where}</span>
							</p>
							<p>{c.line}</p>
							<span class="open">See how it works</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.clients {
		padding-block: 24px 96px;
	}
	h2 {
		margin-top: 12px;
		font-size: clamp(2rem, 4vw, 3rem);
		max-width: 20ch;
	}
	ul {
		list-style: none;
		margin: 40px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
	}
	a {
		height: 100%;
		display: grid;
		align-content: start;
		gap: 10px;
		padding: 24px 22px 26px;
		background: var(--card);
		border-top: 3px solid var(--pigment);
		box-shadow: 0 0 0 1px color-mix(in oklab, var(--pigment) 18%, var(--faint));
		color: var(--text);
		text-decoration: none;
		transition: box-shadow 200ms var(--ease), transform 200ms var(--ease);
	}
	a:hover {
		box-shadow: 0 0 0 1px color-mix(in oklab, var(--pigment) 50%, var(--faint)), 0 14px 30px -18px var(--pigment);
		transform: translateY(-2px);
	}
	a:active {
		transform: translateY(0) scale(0.99);
	}
	.swatch {
		width: 28px;
		height: 18px;
		background: linear-gradient(135deg, color-mix(in oklab, var(--pigment) 40%, var(--card)), var(--pigment));
		clip-path: polygon(0 30%, 50% 0, 100% 30%, 100% 70%, 50% 100%, 0 70%);
	}
	h3 {
		font-size: 1.6rem;
		line-height: 1.1;
	}
	.kind {
		display: grid;
		gap: 4px;
		color: var(--strong);
		font-weight: 500;
	}
	p {
		font-size: 0.98rem;
	}
	.open {
		margin-top: 6px;
		color: var(--sanguine-ink);
		font-weight: 500;
		font-size: 0.95rem;
	}
	.open::after {
		content: ' ›';
	}
	@media (max-width: 560px) {
		.clients {
			padding-bottom: 64px;
		}
	}
</style>
