---
import { Picture } from 'astro:assets';
import sibyl from '../assets/art/sibyl.jpg';
import { BOOK_CALL_HREF } from '../lib/cta';
---

<section class="closing" data-reveal>
	<div class="wrap grid">
		<figure data-reveal-item>
			<Picture
				src={sibyl}
				formats={['avif', 'webp']}
				widths={[400, 640, 960]}
				sizes="(min-width: 900px) 480px, 80vw"
				alt="Michelangelo's red chalk studies for the Libyan Sibyl: a figure turning, arms raised, with studies of a head and hands."
				loading="lazy"
			/>
			<figcaption>Michelangelo, <i>Studies for the Libyan Sibyl</i>, red chalk, c. 1511. The Met.</figcaption>
		</figure>
		<div class="call" data-reveal-item>
			<h2>Tell us about your business.</h2>
			<p class="line">
				Every great piece starts as a study. One short call: no jargon, no pressure, and an honest answer about whether
				we can help.
			</p>
			<a class="btn-call" href={BOOK_CALL_HREF}>Book a call</a>
		</div>
	</div>
</section>

<style>
	.closing {
		padding-block: 72px 120px;
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
		gap: clamp(32px, 6vw, 88px);
		align-items: center;
	}
	figure {
		margin: 0;
		display: grid;
		gap: 10px;
	}
	/* The study's own paper multiplies into ours, so the sheet sits on the page rather than in a box. */
	figure :global(img) {
		width: 100%;
		height: auto;
		mix-blend-mode: multiply;
		mask-image: linear-gradient(transparent, #000 5%, #000 95%, transparent), linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
		mask-composite: intersect;
	}
	figcaption {
		font-size: 0.82rem;
		color: var(--muted);
	}
	.call {
		display: grid;
		justify-items: start;
		gap: 20px;
	}
	h2 {
		font-size: clamp(2.4rem, 5vw, 4rem);
		max-width: 12ch;
	}
	.line {
		max-width: 40ch;
		font-size: 1.15rem;
	}
	@media (max-width: 899px) {
		.grid {
			grid-template-columns: 1fr;
		}
		figure {
			max-width: 420px;
			margin-inline: auto;
		}
		.closing {
			padding-bottom: 80px;
		}
	}
</style>
