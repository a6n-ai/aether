---
import { Picture } from 'astro:assets';
import light from '../assets/art/light.jpg';
import { BOOK_CALL_HREF } from '../lib/cta';
---

<section class="closing">
	<figure>
		<Picture
			src={light}
			formats={['avif', 'webp']}
			widths={[480, 800, 1246]}
			sizes="100vw"
			alt="Michelangelo's Separation of Light from Darkness: a figure reaching upward through the clouds."
			loading="lazy"
		/>
		<figcaption class="wrap">Michelangelo, <i>The Separation of Light from Darkness</i>, Sistine Chapel ceiling, c. 1512.</figcaption>
	</figure>
	<div class="wrap call">
		<p class="mono">Plate III · The call</p>
		<h2>Tell us about your business.</h2>
		<p class="line">One short call. No jargon, no pressure. We'll tell you honestly if we can help.</p>
		<a class="btn-call" href={BOOK_CALL_HREF}>Book a call</a>
	</div>
</section>

<style>
	.closing {
		padding-block: 24px 112px;
	}
	figure {
		max-width: 1120px;
		margin: 0 auto;
		position: relative;
	}
	figure :global(img) {
		width: 100%;
		height: clamp(220px, 34vw, 420px);
		object-fit: cover;
		object-position: 50% 18%;
		filter: saturate(0.8) contrast(0.96);
		mask-image: linear-gradient(transparent, #000 14%, #000 72%, transparent), linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
		mask-composite: intersect;
	}
	figcaption {
		margin-top: 8px;
		font-size: 0.82rem;
		color: var(--muted);
		text-align: right;
	}
	.call {
		display: grid;
		justify-items: center;
		gap: 16px;
		margin-top: 32px;
		text-align: center;
	}
	h2 {
		font-size: clamp(2.2rem, 5vw, 3.6rem);
	}
	.line {
		max-width: 46ch;
		font-size: 1.1rem;
	}
	.btn-call {
		margin-top: 8px;
	}
	@media (max-width: 560px) {
		.closing {
			padding-bottom: 72px;
		}
		figcaption {
			text-align: center;
		}
	}
</style>
