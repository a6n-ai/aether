---
import { Picture } from 'astro:assets';
import creation from '../assets/art/creation.jpg';
import { BOOK_CALL_HREF } from '../lib/cta';

// The whole Creation of Adam, shown twice: once cut to Adam's side of the finger gap and once to God's.
// At rest the two line up pixel for pixel; on scroll they slide together, so the merge is ours to time.
const GAP = { x: 37.9, y: 45.3 }; // the finger gap, in % of the fresco
const ALT = "Michelangelo's Creation of Adam: Adam reclines on the earth and reaches out; God, carried in a red cloak among angels, reaches back; their fingers almost touch.";
const picture = { src: creation, formats: ['avif', 'webp'], widths: [900, 1400, 2000, 2600], sizes: 'max(100vw, 220svh)' } as const;
---

<section class="hero" data-hero aria-labelledby="hero-title">
	<div class="stage" data-stage style={`--gx:${GAP.x}%;--gy:${GAP.y}%`}>
		<div class="scene" data-scene>
			<div class="side fill" aria-hidden="true">
				<Picture {...picture} alt="" loading="eager" />
			</div>
			<div class="side adam" data-side="adam">
				<Picture {...picture} alt={ALT} loading="eager" fetchpriority="high" />
			</div>
			<div class="side god" data-side="god" aria-hidden="true">
				<Picture {...picture} alt="" loading="eager" />
			</div>
			<div class="glow" data-glow aria-hidden="true"></div>
		</div>
		<div class="veil" aria-hidden="true"></div>

		<div class="copy" data-hero-copy>
			<h1 id="hero-title" data-split="lines" data-intro>Your business, <em>working on its own.</em></h1>
			<p class="sub">We build the website and app your business runs on: orders, bookings, payments and messages, all in one place.</p>
			<p class="actions">
				<a class="btn-call" href={BOOK_CALL_HREF}>Book a call</a>
				<a class="how" href="#bench">How we work</a>
			</p>
		</div>

		<p class="touch" data-touch>Every part of your business,<br /><em>finally in reach.</em></p>

		<div class="cue" data-cue aria-hidden="true">
			<span>Scroll to bring them together</span>
			<span class="line"><span data-bar></span></span>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { getWorld } from '../scripts/world/index';
	import { boxOf } from '../scripts/world/layout';

	gsap.registerPlugin(ScrollTrigger);
	// the router swaps pages without reloading, so the hero sets itself up each time the home page arrives
	document.addEventListener('astro:page-load', () => {
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const scene = hero?.querySelector<HTMLElement>('[data-scene]');
	const stage = hero?.querySelector<HTMLElement>('[data-stage]');

	if (hero && scene && stage && document.documentElement.classList.contains('motion')) {
		const adam = scene.querySelector<HTMLElement>('[data-side="adam"]')!;
		const god = scene.querySelector<HTMLElement>('[data-side="god"]')!;
		const glow = scene.querySelector<HTMLElement>('[data-glow]')!;
		const small = matchMedia('(max-width: 767px)').matches;
		// How far apart the sides start, as a share of the scene's width; phones start closer so both hands show.
		const open = () => scene.offsetWidth * (small ? 0.035 : 0.13) * 0.5;
		const set = (spread: number, light: number, push: number) => {
			adam.style.translate = `${-spread}px 0`;
			god.style.translate = `${spread}px 0`;
			scene.style.scale = String(1 + push * 0.9);
			glow.style.opacity = String(Math.min(1, light));
		};
		// First frame: the two sides drawn apart, then they ease in a little as the page arrives.
		const intro = { v: 1.15 };
		set(open() * intro.v, 0, 0);
		gsap.to(intro, { v: 1, duration: 1.6, ease: 'power3.out', delay: 0.2, onUpdate: () => set(open() * intro.v, 0, 0) });

		const touch = hero.querySelector<HTMLElement>('[data-touch]');
		const bar = hero.querySelector<HTMLElement>('[data-bar]');
		const range = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)));

		gsap.to('[data-hero-copy]', {
			autoAlpha: 0,
			y: -60,
			ease: 'none',
			scrollTrigger: { trigger: hero, start: '12% top', end: '30% top', scrub: true },
		});
		gsap.to('[data-cue]', { autoAlpha: 0, ease: 'none', scrollTrigger: { trigger: hero, start: '2% top', end: '10% top', scrub: true } });

		ScrollTrigger.create({
			trigger: hero,
			start: 'top top',
			end: 'bottom bottom',
			onUpdate: (self) => {
				const p = self.progress;
				if (p <= 0) return;
				// Close by 0.42, then hold the touching hands until 0.72 so the meeting is a resting frame, not a pass-through.
				const close = gsap.parseEase('power2.inOut')(range(p, 0, 0.42));
				const light = range(p, 0.32, 0.5);
				const push = gsap.parseEase('power2.inOut')(range(p, 0.72, 1));
				set(open() * (1 - close), light + push * 0.8, push);
				// through the finger gap and onto the sheet: the fresco gives way to the world, framed on the bench,
				// and the gap's light carries over and fades as you land
				const out = range(p, 0.92, 1);
				stage.style.opacity = String(1 - out);
				const world = getWorld(), bench = boxOf('bench')!;
				world?.setLight(out > 0 ? 1 - out : 0, [bench.x + bench.w / 2, bench.y + bench.h / 2]);
				if (touch) {
					const t = range(p, 0.4, 0.5) * (1 - range(p, 0.74, 0.84));
					touch.style.opacity = String(t);
					touch.style.translate = `0 ${(1 - range(p, 0.4, 0.5)) * 24}px`;
				}
				if (bar) bar.style.transform = `scaleX(${p})`;
			},
		});
	}
	});
</script>

<style>
	.hero {
		position: relative;
		margin-top: calc(-1 * var(--nav-h));
	}
	.stage {
		position: relative;
		height: 100svh;
		min-height: 560px;
		overflow: clip;
		display: grid;
		place-items: center;
		background: var(--page);
	}
	/* The fresco covers the stage, held on the finger gap, at its own proportions. */
	.stage {
		background: var(--fresco-sky);
	}
	.scene {
		position: absolute;
		left: 50%;
		top: 50%;
		/* Big enough that, held on the off-centre gap (38% across, 45% down), it still reaches every edge. */
		height: max(100% / (2 * 0.453), 100vw / (2 * 0.379) * 1180 / 2600);
		aspect-ratio: 2600 / 1180;
		translate: calc(-1 * var(--gx)) calc(-1 * var(--gy));
		transform-origin: var(--gx) var(--gy);
	}
	.side,
	.side :global(picture),
	.side :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	/* Behind both sides: the fresco's own column at the gap, stretched sideways, so the opening shows the
	   real sky, hill and earth row by row instead of a blank band. */
	.fill {
		scale: 40 1;
		transform-origin: var(--gx) 50%;
		filter: blur(5px);
	}
	/* Each side keeps its half, the cut feathered across the plaster between the fingers. */
	.adam {
		mask: linear-gradient(to right, #000 calc(var(--gx) - 1.2%), transparent var(--gx));
	}
	.god {
		mask: linear-gradient(to right, transparent calc(var(--gx) - 1.2%), #000 var(--gx));
	}
	.glow {
		position: absolute;
		left: var(--gx);
		top: var(--gy);
		width: 34%;
		aspect-ratio: 1;
		translate: -50% -50%;
		background: radial-gradient(closest-side, color-mix(in oklab, var(--gap-light) 85%, transparent), transparent);
		mix-blend-mode: screen;
		opacity: 0;
		pointer-events: none;
	}
	/* Behind the type only: a soft wash of the painting's own sky, so every word reads. */
	.veil {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(60% 46% at 50% 40%, color-mix(in oklab, var(--page) 70%, transparent), transparent 70%);
	}
	.copy {
		position: relative;
		z-index: 2;
		display: grid;
		justify-items: center;
		width: 100%;
		max-width: 980px;
		padding: var(--nav-h) var(--gutter) 0;
		text-align: center;
		translate: 0 -6vh;
		pointer-events: none;
	}
	.copy a {
		pointer-events: auto;
	}
	h1 {
		font-size: clamp(3rem, 1.4rem + 6.4vw, 8.4rem);
		line-height: 0.9;
		letter-spacing: -0.035em;
		max-width: 11ch;
	}
	h1 em {
		color: var(--sanguine-ink);
	}
	.sub {
		margin-top: clamp(18px, 2.6vh, 28px);
		max-width: 36ch;
		font-size: var(--t-m);
		line-height: 1.4;
		color: var(--strong);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 12px 28px;
		margin-top: 28px;
	}
	/* The same highlighter as the page's other secondary links, stronger so it reads over the painting. */
	.how {
		display: inline-block;
		padding-block: 3px;
		color: var(--strong);
		text-decoration: none;
		background: linear-gradient(color-mix(in oklab, var(--sanguine) 55%, transparent) 0 0) left 100% / 100% 2px no-repeat;
		transition: background-size 420ms var(--ease);
	}
	.how:focus-visible {
		background-size: 100% 0.55em;
	}
	@media (hover: hover) {
		.how:hover {
			background-size: 100% 0.55em;
		}
	}

	.touch {
		position: absolute;
		z-index: 2;
		inset: calc(var(--nav-h) + 8vh) 0 auto;
		width: min(24ch, calc(100% - 2 * var(--gutter)));
		translate: 0 24px;
		margin: 0 auto;
		text-align: center;
		font: 400 var(--t-l) / 1.05 var(--font-display);
		letter-spacing: -0.02em;
		color: var(--strong);
		opacity: 0;
		pointer-events: none;
	}
	.touch em {
		color: var(--sanguine-ink);
	}

	.cue {
		position: absolute;
		z-index: 2;
		left: 50%;
		bottom: clamp(20px, 4vh, 40px);
		translate: -50% 0;
		display: grid;
		justify-items: center;
		gap: 10px;
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		color: var(--strong);
		white-space: nowrap;
	}
	.cue .line {
		display: block;
		width: 96px;
		height: 2px;
		background: color-mix(in oklab, var(--strong) 18%, transparent);
	}
	.cue .line span {
		display: block;
		height: 100%;
		background: var(--sanguine);
		transform: scaleX(0);
		transform-origin: left;
	}

	/* Motion: 180svh of scroll belongs to the hands. */
	:global(html.motion) .hero {
		height: 280svh;
	}
	:global(html.motion) .stage {
		position: sticky;
		top: 0;
	}
	:global(html:not(.motion)) .cue,
	:global(html:not(.motion)) .touch {
		display: none;
	}

	@media (max-width: 767px) {
		.copy {
			translate: 0 -4vh;
		}
		h1 {
			font-size: clamp(2.9rem, 13vw, 4.2rem);
			max-width: 9ch;
		}
		.sub {
			font-size: 1.05rem;
			max-width: 30ch;
		}
		.touch {
			top: calc(var(--nav-h) + 6vh);
		}
	}
</style>
