---
import { Picture } from 'astro:assets';
import hands from '../assets/art/hands.jpg';
import { BOOK_CALL_HREF } from '../lib/cta';
---

<section class="hero" data-hero aria-labelledby="hero-title">
	<div class="stage" data-stage>
		<Picture
			src={hands}
			formats={['avif', 'webp']}
			widths={[480, 800, 1280, 1533]}
			sizes="100vw"
			alt="Michelangelo's Creation of Adam: two hands reaching toward each other, almost touching."
			loading="eager"
			fetchpriority="high"
			class="wall-img"
			data-wall
		/>
		<div class="veil" aria-hidden="true"></div>

		<div class="copy" data-hero-copy>
			<h1 id="hero-title" data-split="lines" data-intro>Your business, <em>working on its own.</em></h1>
			<p class="sub">We build the website and app your business runs on: orders, bookings, payments and messages, all in one place.</p>
			<p class="actions" data-reveal="up" data-intro data-delay="0.5">
				<a class="btn-call" href={BOOK_CALL_HREF}>Book a call</a>
				<a class="how" href="#who">How we work</a>
			</p>
		</div>

		<p class="touch" data-touch>Every part of your business,<br /><em>finally in reach.</em></p>

		<div class="cue" data-cue aria-hidden="true">
			<span>Scroll to bring them together</span>
			<span class="line"><span data-bar></span></span>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { mountHands } from '../scripts/hands';

	gsap.registerPlugin(ScrollTrigger);
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const stage = hero?.querySelector<HTMLElement>('[data-stage]');
	const img = stage?.querySelector<HTMLImageElement>('img[data-wall]');

	if (hero && stage && img && document.documentElement.classList.contains('motion')) {
		const start = () => {
			const small = matchMedia('(max-width: 767px)').matches;
			const open = small ? 0.08 : 0.23;
			const scene = mountHands(stage, img, [0.925, 0.902, 0.855]);
			if (!scene) stage.classList.add('no-gl');
			// First frame: hands drawn apart, then they ease in a little as the page arrives.
			scene?.set({ spread: open * 1.15 });
			gsap.delayedCall(0.2, () => scene?.set({ spread: open }));

			const touch = hero.querySelector<HTMLElement>('[data-touch]');
			const bar = hero.querySelector<HTMLElement>('[data-bar]');
			const range = (p: number, a: number, b: number) => Math.min(1, Math.max(0, (p - a) / (b - a)));

			gsap.to('[data-hero-copy]', {
				autoAlpha: 0,
				y: -60,
				ease: 'none',
				scrollTrigger: { trigger: hero, start: 'top top', end: '22% top', scrub: true },
			});
			gsap.to('[data-cue]', { autoAlpha: 0, ease: 'none', scrollTrigger: { trigger: hero, start: '2% top', end: '10% top', scrub: true } });

			ScrollTrigger.create({
				trigger: hero,
				start: 'top top',
				end: 'bottom bottom',
				onUpdate: (self) => {
					const p = self.progress;
					const close = gsap.parseEase('power2.inOut')(range(p, 0, 0.55));
					const light = range(p, 0.42, 0.62);
					const push = gsap.parseEase('power2.inOut')(range(p, 0.7, 1));
					scene?.set({ spread: open * (1 - close), light: light + push * 0.8, zoom: 1 + push * 0.9, fade: 0 });
					if (touch) {
						const t = range(p, 0.5, 0.6) * (1 - range(p, 0.74, 0.84));
						touch.style.opacity = String(t);
						touch.style.translate = `0 ${(1 - range(p, 0.5, 0.6)) * 24}px`;
					}
					if (bar) bar.style.transform = `scaleX(${p})`;
				},
			});
		};
		img.complete ? start() : img.addEventListener('load', start, { once: true });
	}
</script>

<style>
	.hero {
		position: relative;
		margin-top: calc(-1 * var(--nav-h));
	}
	.stage {
		position: relative;
		height: 100svh;
		min-height: 560px;
		overflow: clip;
		display: grid;
		place-items: center;
		background: var(--page);
	}
	.stage :global(.hands-canvas),
	.wall-img,
	.stage :global(picture) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.stage :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 49.6% 50%;
	}
	/* Behind the type only: a soft wash of the painting's own sky, so every word reads. */
	.veil {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(60% 46% at 50% 40%, color-mix(in oklab, var(--page) 70%, transparent), transparent 70%);
	}
	.copy {
		position: relative;
		z-index: 2;
		display: grid;
		justify-items: center;
		width: 100%;
		max-width: 980px;
		padding: var(--nav-h) var(--gutter) 0;
		text-align: center;
		translate: 0 -6vh;
		pointer-events: none;
	}
	.copy a {
		pointer-events: auto;
	}
	h1 {
		font-size: clamp(3rem, 1.4rem + 6.4vw, 8.4rem);
		line-height: 0.9;
		letter-spacing: -0.035em;
		max-width: 11ch;
	}
	h1 em {
		color: var(--sanguine-ink);
	}
	.sub {
		margin-top: clamp(18px, 2.6vh, 28px);
		max-width: 36ch;
		font-size: var(--t-m);
		line-height: 1.4;
		color: var(--strong);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 12px 28px;
		margin-top: 28px;
	}
	.how {
		color: var(--strong);
	}

	.touch {
		position: absolute;
		z-index: 2;
		inset: calc(var(--nav-h) + 8vh) 0 auto;
		width: min(24ch, calc(100% - 2 * var(--gutter)));
		translate: 0 24px;
		margin: 0 auto;
		text-align: center;
		font: 400 var(--t-l) / 1.05 var(--font-display);
		letter-spacing: -0.02em;
		color: var(--strong);
		opacity: 0;
		pointer-events: none;
	}
	.touch em {
		color: var(--sanguine-ink);
	}

	.cue {
		position: absolute;
		z-index: 2;
		left: 50%;
		bottom: clamp(20px, 4vh, 40px);
		translate: -50% 0;
		display: grid;
		justify-items: center;
		gap: 10px;
		font-size: var(--t-xs);
		letter-spacing: 0.02em;
		color: var(--strong);
		white-space: nowrap;
	}
	.cue .line {
		display: block;
		width: 96px;
		height: 2px;
		background: color-mix(in oklab, var(--strong) 18%, transparent);
	}
	.cue .line span {
		display: block;
		height: 100%;
		background: var(--sanguine);
		transform: scaleX(0);
		transform-origin: left;
	}

	/* Motion: 160svh of scroll belongs to the hands. The canvas replaces the picture once it draws. */
	:global(html.motion) .hero {
		height: 240svh;
	}
	:global(html.motion) .stage {
		position: sticky;
		top: 0;
	}
	.stage:global(.is-live) :global(picture) {
		visibility: hidden;
	}
	/* Without the canvas the painting sits whole; a wider wash keeps the type on sky. */
	:global(html:not(.motion)) .veil,
	.stage.no-gl .veil {
		background: linear-gradient(color-mix(in oklab, var(--page) 86%, transparent) 30%, color-mix(in oklab, var(--page) 40%, transparent) 70%, transparent);
	}
	:global(html:not(.motion)) .cue,
	:global(html:not(.motion)) .touch {
		display: none;
	}

	@media (max-width: 767px) {
		.copy {
			translate: 0 -4vh;
		}
		h1 {
			font-size: clamp(2.9rem, 13vw, 4.2rem);
			max-width: 9ch;
		}
		.sub {
			font-size: 1.05rem;
			max-width: 30ch;
		}
		.touch {
			top: calc(var(--nav-h) + 6vh);
		}
	}
</style>
