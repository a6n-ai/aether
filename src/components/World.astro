---
// The world: one fixed canvas behind every page, drawing the a6n sheet. It persists across page swaps
// (transition:persist in Layout), so moving between pages is the camera travelling, not a reload.
import { getImage } from 'astro:assets';
import vitruvian from '../assets/art/vitruvian.jpg';
import { STILLS } from '../data/world';
import { REGIONS, STROKES } from '../scripts/world/layout';

const stills: Record<string, string> = {};
for (const [id, img] of Object.entries(STILLS)) stills[id] = (await getImage({ src: img, width: Math.min(1400, img.width), format: 'webp', quality: 72 })).src;
const films = Object.fromEntries(REGIONS.filter((r) => r.film).map((r) => [r.film!, `/world/${r.film}.mp4`]));
const vit = (await getImage({ src: vitruvian, width: 800, format: 'webp', quality: 75 })).src;
const data = JSON.stringify({ regions: REGIONS, strokes: STROKES, stills, films, vitruvian: vit });
---

<canvas class="world" aria-hidden="true" data-world={data}></canvas>

<script>
	import { createWorld } from '../scripts/world/render';
	import { measureFps, shouldDegrade } from '../scripts/world/degrade';
	import { getWorld, setWorld } from '../scripts/world/index';

	const canvas = document.querySelector<HTMLCanvasElement>('canvas.world');
	const root = document.documentElement;
	const flat = () => { root.classList.remove('world'); root.classList.add('flat'); getWorld()?.destroy(); setWorld(null); };
	if (canvas && !getWorld()) {
		const env = {
			reduced: matchMedia('(prefers-reduced-motion: reduce)').matches,
			canvas: !!canvas.getContext('2d'),
			deviceMemory: (navigator as Navigator & { deviceMemory?: number }).deviceMemory,
		};
		if (shouldDegrade(env)) flat();
		else {
			root.classList.add('world');
			const world = createWorld(canvas, JSON.parse(canvas.dataset.world!));
			setWorld(world);
			addEventListener('resize', () => world.resize());
			// a world that cannot keep up gives way to the still page
			measureFps(2000).then((fps) => shouldDegrade({ ...env, fps }) && flat());
		}
	}
</script>

<style>
	.world {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100svh;
		z-index: 0;
		display: none;
		pointer-events: none;
	}
	:global(html.world) .world {
		display: block;
	}
</style>
