---
// One stop on the walk across the world: a stretch of scroll (1.6 screens) with its words pinned beside the place
// the camera is framing. On the still page (no canvas) the place's drawing sits inline above the words.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	id: string;
	side: 'left' | 'right' | 'center';
	heading: string;
	still?: ImageMetadata;
	stillAlt?: string;
	href?: string;
	linkText?: string;
	first?: boolean;
	/** Text too long to pin: the panel scrolls with the page instead. */
	long?: boolean;
	/** On the home page the hero holds the page's h1. */
	home?: boolean;
	/** One big sentence, centred under the drawing, its words inking in as you scroll. */
	statement?: boolean;
	/** A wider panel, for a product with its screens. */
	wide?: boolean;
}
const { id, side, heading, still, stillAlt = '', href, linkText, first = false, long = false, home = false, statement = false, wide = false } = Astro.props;
const words = heading.split(' ');
---

<section class:list={['stop', side, { long, first, statement, wide }]} data-stop={id} id={id} aria-labelledby={`stop-${id}`}>
	<div class="panel">
		{still && <Picture src={still} formats={['avif', 'webp']} widths={[480, 900]} sizes="(max-width: 767px) 100vw, 640px" alt={stillAlt} class="still" loading={first ? 'eager' : 'lazy'} />}
		{/* a page that opens on a stop (every page but home) titles itself with the first stop's heading */}
		{
			statement ? (
				<h2 id={`stop-${id}`} class="said" data-words>
					{words.map((w) => <span class="w">{w} </span>)}
				</h2>
			) : first && !home ? (
				<h1 id={`stop-${id}`}>{heading}</h1>
			) : (
				<h2 id={`stop-${id}`}>{heading}</h2>
			)
		}
		<slot />
		{href && <a class="go" href={href}>{linkText}</a>}
	</div>
</section>

<style>
	.stop {
		position: relative;
		padding-inline: var(--gutter);
	}
	.panel {
		max-width: 38ch;
		display: grid;
		gap: 14px;
	}
	.panel :global(p) {
		color: var(--strong);
		font-size: var(--t-m);
		line-height: 1.45;
	}
	h1,
	h2 {
		font-size: var(--t-xl);
		line-height: 0.95;
		letter-spacing: -0.03em;
	}
	.go {
		justify-self: start;
		color: var(--strong);
		text-decoration: none;
		padding-block: 3px;
		background: linear-gradient(color-mix(in oklab, var(--sanguine) 55%, transparent) 0 0) left 100% / 100% 2px no-repeat;
		transition: background-size 420ms var(--ease);
	}
	.go:focus-visible {
		background-size: 100% 0.55em;
	}
	@media (hover: hover) {
		.go:hover {
			background-size: 100% 0.55em;
		}
	}

	/* The still page: each place's drawing inline, then its words, in page order. */
	/* the drawings are inked on white for the world's multiply; here too, so only the ink lands on the page */
	.still {
		width: 100%;
		height: auto;
		mix-blend-mode: multiply;
	}
	:global(html:not(.world)) .stop {
		padding-block: clamp(48px, 9vh, 96px);
	}
	:global(html:not(.world)) .panel {
		max-width: 720px;
		margin-inline: auto;
	}

	/* The world: the stop is a stretch of scroll; its words ride pinned beside the place in view. */
	:global(html.world) .stop {
		height: 160svh;
	}
	:global(html.world) .still {
		display: none;
	}
	:global(html.world) h1,
	:global(html.world) h2 {
		font-size: clamp(1.9rem, 1.2rem + 1.6vw, 3rem);
	}
	:global(html.world) .panel {
		position: sticky;
		top: max(calc(var(--nav-h) + 16px), calc(50svh - 220px));
		margin-top: 60svh;
		padding: 26px 28px;
		background: color-mix(in oklab, var(--card) 86%, transparent);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
		box-shadow: 0 18px 50px -24px color-mix(in oklab, var(--strong) 40%, transparent);
		border-radius: 6px;
	}
	:global(html.world) .right .panel {
		margin-left: auto;
		margin-right: clamp(0px, 4vw, 64px);
	}
	:global(html.world) .left .panel {
		margin-left: clamp(0px, 4vw, 64px);
	}
	:global(html.world) .long {
		height: auto;
		min-height: 160svh;
		padding-bottom: 40svh;
	}
	/* A statement: one sentence, big and centred under the drawing, inking in word by word (scroll.ts). */
	.said .w {
		transition: color 380ms var(--ease);
	}
	:global(html.world) .statement .panel {
		top: 56svh;
		margin-inline: auto;
		max-width: min(980px, 86vw);
		text-align: center;
		justify-items: center;
		background: radial-gradient(60% 70% at 50% 50%, color-mix(in oklab, var(--card) 70%, transparent), transparent 75%);
		box-shadow: none;
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		padding: 24px 48px 32px;
	}
	:global(html.world) .statement :global(p) {
		max-width: 56ch;
	}
	:global(html.world) .statement .said {
		font-size: clamp(2rem, 1rem + 2.6vw, 3.6rem);
		line-height: 1.06;
		max-width: 22ch;
	}
	:global(html.world) .statement .said .w {
		color: color-mix(in oklab, var(--strong) 26%, transparent);
	}
	:global(html.world) .statement .said .w:global(.on) {
		color: var(--strong);
	}
	:global(html.world) .statement :global(p) {
		color: var(--text);
	}
	/* a product with its screens is tall: pin it under the nav so all of it stays in view */
	:global(html.world) .wide .panel {
		max-width: min(46ch, 44vw);
		top: calc(var(--nav-h) + 16px);
	}
	/* a page that opens on this stop: its words are there from the start, not a screen below */
	:global(html.world) .first .panel {
		margin-top: 16svh;
	}
	:global(html.world) .long .panel {
		position: relative;
		top: auto;
	}
	@media (max-width: 767px) {
		/* phones: the place fills the top of the screen, the words ride below it */
		:global(html.world) .panel,
		:global(html.world) .right .panel,
		:global(html.world) .left .panel {
			/* pinned under the drawing, which the camera frames in the top third */
			position: sticky;
			top: 58svh;
			margin: 40svh 0 0;
			max-width: none;
			max-height: 40svh;
			overflow: auto;
			padding: 18px 20px;
		}
		/* a statement is never cut short, and a product's screens are never hidden in a scroll box */
		:global(html.world) .statement .panel {
			top: 46svh;
			max-height: none;
			overflow: visible;
			background: radial-gradient(70% 70% at 50% 50%, color-mix(in oklab, var(--card) 80%, transparent), transparent 80%);
		}
		:global(html.world) .wide {
			height: auto;
			min-height: 160svh;
			padding-bottom: 30svh;
		}
		:global(html.world) .wide .panel {
			position: relative;
			top: auto;
			max-height: none;
			overflow: visible;
		}
	}
</style>
