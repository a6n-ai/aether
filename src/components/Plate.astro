---
import '../styles/anatomy.css';
import '../styles/plate.css';
import type { Machine } from '../lib/plate';

interface Props {
	/** data-machine id, used by tests and styles. */
	name: string;
	machine: Machine;
	fig: string;
	title: string;
	caption: string;
	/** CSS color for the machine body, e.g. 'var(--ochre)'. Defaults to raw umber. */
	pigment?: string;
	compact?: boolean;
}

const { name, machine, fig, title, caption, pigment = 'var(--umber)', compact = false } = Astro.props;
const steps = machine.labels.length;
---

<figure
	class:list={['iso machine plate', { compact }]}
	style={`--pigment:${pigment}`}
	data-machine={name}
	data-steps={steps}
	data-transforms={JSON.stringify(machine.transforms)}
>
	<div class="corners" aria-hidden="true">
		<span data-corner="fig">{fig}</span>
		<span data-corner="title">{title}</span>
	</div>
	<div class="stage" set:html={machine.svg} />
	<div class="controls">
		<ol class="steps">
			{machine.labels.map((label, i) => <li data-step={i + 1} aria-current={i + 1 === steps ? 'step' : undefined}>{label}</li>)}
		</ol>
		<div class="nav" hidden>
			<button type="button" data-prev aria-label="Previous step">‹</button>
			<span class="readout" data-readout aria-live="off">{steps} / {steps}</span>
			<button type="button" data-next aria-label="Next step">›</button>
		</div>
	</div>
	<figcaption>{caption}</figcaption>
</figure>

<script>
	import { mountPlate } from '../scripts/plate';
	document.querySelectorAll<HTMLElement>('figure.machine[data-steps]').forEach((root) => mountPlate(root));
</script>

<style>
	.plate {
		position: relative;
		margin: 0;
		padding: 48px 28px 28px;
		background: var(--card);
		box-shadow: 0 0 0 1px color-mix(in oklab, var(--pigment) 30%, var(--card));
		display: grid;
		gap: 20px;
	}
	.plate.compact {
		padding: 40px 18px 20px;
		gap: 14px;
	}
	.corners span {
		position: absolute;
		top: 18px;
		font: 10.5px/1 var(--font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.corners [data-corner='fig'] {
		left: 22px;
		color: var(--text);
	}
	.corners [data-corner='title'] {
		right: 22px;
	}
	.stage {
		max-width: 880px;
		width: 100%;
		margin-inline: auto;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		border-top: 1px solid var(--faint);
		padding-top: 18px;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
		counter-reset: s;
	}
	.compact .steps {
		display: grid;
		gap: 6px;
	}
	.steps li {
		counter-increment: s;
		color: var(--muted);
		font-size: 0.95rem;
		transition: color 300ms var(--ease);
	}
	.steps li::before {
		content: counter(s) '  ';
		font: 600 0.72rem var(--font-mono);
		white-space: pre;
	}
	.steps li[aria-current='step'] {
		color: var(--strong);
	}
	.steps li[aria-current='step']::before {
		color: var(--sanguine-ink);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.nav button {
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--faint);
		background: var(--page);
		color: var(--strong);
		font-size: 1.3rem;
		cursor: pointer;
		transition: background-color 160ms var(--ease);
	}
	.nav button:hover {
		background: var(--card);
	}
	.readout {
		min-width: 3.5em;
		text-align: center;
		font: 0.8rem var(--font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}
	figcaption {
		max-width: 62ch;
		font-size: 1.05rem;
		color: var(--text);
	}
	.compact figcaption {
		font-size: 0.98rem;
	}
	@media (max-width: 560px) {
		.plate {
			padding: 40px 12px 20px;
		}
	}
</style>
