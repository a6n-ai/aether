---
import '../styles/anatomy.css';
import '../styles/plate.css';
import { Picture } from 'astro:assets';
import { machineOf, plateStyle, type PlateName } from '../machines/registry';
import { DRAWINGS } from '../data/drawings';

interface Props {
	/** Plate id from the registry; also data-machine, used by tests and styles. */
	name: PlateName;
	fig: string;
	title: string;
	caption: string;
	compact?: boolean;
	/** Driven by scroll from the page (a 'plate:step' event) instead of touring on its own. */
	scrub?: boolean;
}

const { name, fig, title, caption, compact = false, scrub = false } = Astro.props;
const machine = machineOf(name);
const steps = machine.labels.length;
// The page ships the finished plate as a small lazy poster (no-JS readers see the whole story at once, even on
// a slow phone); plate.ts swaps in the live SVG (200-400 KB) as it nears the viewport. scripts/posters.ts draws them.
const label = machine.svg.match(/aria-label="([^"]*)"/)?.[1] ?? caption;
const [, , width, height] = (machine.svg.match(/viewBox="([^"]*)"/)?.[1] ?? '0 0 720 480').split(' ').map(Number);
// An old-master sheet stands in for the machine when one is listed; the light rests on the last step until it tours.
const drawing = DRAWINGS[name];
const last = drawing?.steps[steps - 1];
const spot = last ? `--fx:${last[0] * 100}%;--fy:${last[1] * 100}%;--fr:${last[2] * 100}%;` : '';
// The pen's route between the step spots, in a 1000-wide box that keeps the sheet's proportions.
const traceH = drawing ? Math.round((1000 * drawing.image.height) / drawing.image.width) : 0;
const pts = drawing?.steps.map(([x, y]) => [x * 1000, y * traceH] as const) ?? [];
// Each leg bows a little to one side, like a hand-drawn arrow between two notes.
const legs = pts.slice(1).map(([x, y], i) => {
	const [px, py] = pts[i];
	const [mx, my] = [(px + x) / 2, (py + y) / 2];
	const [dx, dy] = [x - px, y - py];
	return `M${px} ${py} Q${mx - dy * 0.22} ${my + dx * 0.22} ${x} ${y}`;
});
const notes = drawing
	? pts.map(([x, y], i) => {
			const at = drawing.notes?.[i];
			const nx = at ? at[0] * 1000 : x < 500 ? x + 46 : x - 46;
			return { x: nx, y: at ? at[1] * traceH : y - 34, anchor: nx < 500 ? 'start' : 'end', text: `${['i', 'ii', 'iii', 'iv', 'v'][i]}. ${machine.labels[i]}` };
		})
	: [];
---

<figure
	class:list={['iso machine plate', { compact, drawn: drawing }]}
	style={spot + plateStyle(name)}
	data-machine={name}
	data-steps={steps}
	data-scrub={scrub ? '' : undefined}
	data-transforms={drawing ? undefined : JSON.stringify(machine.transforms)}
	data-drawing={drawing ? JSON.stringify(drawing.steps) : undefined}
>
	<div class="corners" aria-hidden="true">
		<span data-corner="fig">{fig}</span>
		<span data-corner="title">{title}</span>
	</div>
	{
		drawing ? (
			<div class:list={['stage sheet', drawing.medium, { filmed: drawing.film }]} style={`--ar:${drawing.image.width / drawing.image.height};--ink:url(#ink-${name})`}>
				{/* Ink settles darkest lines first: luminance becomes a mask whose threshold plate.ts raises (feFuncA intercept). */}
				<svg class="ink-defs" aria-hidden="true" focusable="false">
					<filter id={`ink-${name}`} x="0" y="0" width="1" height="1" color-interpolation-filters="sRGB">
						<feColorMatrix in="SourceGraphic" type="luminanceToAlpha" result="lum" />
						<feTurbulence type="fractalNoise" baseFrequency="0.014" numOctaves="3" seed="7" result="fibre" />
						<feComposite in="lum" in2="fibre" operator="arithmetic" k1="0" k2="-1" k3="0.3" k4="0.85" result="dark" />
						<feComponentTransfer in="dark" result="mask">
							<feFuncA type="linear" slope="6" intercept="-6" data-ink />
						</feComponentTransfer>
						<feComposite in="SourceGraphic" in2="mask" operator="in" result="inked" />
						<feComponentTransfer in="SourceGraphic" result="ghost">
							<feFuncA type="linear" slope="0.2" />
						</feComponentTransfer>
						<feMerge>
							<feMergeNode in="ghost" />
							<feMergeNode in="inked" />
						</feMerge>
					</filter>
				</svg>
				<Picture src={drawing.image} formats={['avif', 'webp']} quality={60} widths={[600, 900, 1300]} sizes="(max-width: 899px) 100vw, 880px" alt={drawing.alt} loading="lazy" decoding="async" />
				{/* The sheet being drawn, stroke by stroke; its last frame is the picture under it. plate.ts plays it once. */}
				{drawing.film && <video class="film" src={`/plates/films/${drawing.film}.mp4`} muted playsinline preload="none" aria-hidden="true" tabindex="-1" data-film />}
				<span class="light" aria-hidden="true" />
				<svg class="trace" viewBox={`0 0 1000 ${traceH}`} aria-hidden="true" focusable="false">
					<filter id={`hand-${name}`}>
						<feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="3" />
						<feDisplacementMap in="SourceGraphic" scale="5" />
					</filter>
					<g filter={`url(#hand-${name})`}>
						{legs.map((d, i) => <path class="leg on" d={d} pathLength="1" data-at={i + 2} />)}
						{pts.map(([x, y], i) => <circle class="dot on" cx={x} cy={y} r="7" data-at={i + 1} />)}
					</g>
					{notes.map((n, i) => (
						<text class:list={["note on", { now: i === pts.length - 1 }]} x={n.x} y={n.y} text-anchor={n.anchor} data-at={i + 1}>
							{n.text}
						</text>
					))}
				</svg>
				{drawing.keys?.map(([x, y], i) => (
					<span class="tag" data-key={i + 1} style={`left:${x * 100}%;top:${y * 100}%`} aria-hidden="true">
						{i + 1}
					</span>
				))}
			</div>
		) : (
			<div class="stage">
				<img src={`/plates/posters/${name}.webp`} data-svg={`/plates/${name}.svg`} alt={label} width={width} height={height} loading="lazy" decoding="async" data-plate-img onload="this.dataset.loaded=''" />
			</div>
		)
	}
	<div class="controls">
		<ol class="steps">
			{machine.labels.map((label, i) => <li data-step={i + 1} aria-current={i + 1 === steps ? 'step' : undefined}>{label}</li>)}
		</ol>
		<div class="nav" hidden>
			<button type="button" data-prev aria-label="Previous step">‹</button>
			<span class="readout" data-readout aria-live="off">{steps} / {steps}</span>
			<button type="button" data-next aria-label="Next step">›</button>
		</div>
	</div>
	<figcaption>{caption}</figcaption>
</figure>

<script>
	import { mountPlate } from '../scripts/plate';
	document.querySelectorAll<HTMLElement>('figure.machine[data-steps]').forEach((root) => mountPlate(root));
</script>

<style>
	.plate {
		position: relative;
		margin: 0;
		padding: 48px 28px 28px;
		background: var(--card);
		box-shadow: 0 0 0 1px color-mix(in oklab, var(--pigment) 30%, var(--card));
		display: grid;
		gap: 20px;
	}
	.plate.compact {
		padding: 40px 18px 20px;
		gap: 14px;
	}
	.corners span {
		position: absolute;
		top: 18px;
		/* Sentence case in the body face, to match the live figures' corners ("Plate VIII"). */
		font: var(--t-xs) / 1 var(--font-body);
		color: var(--muted);
	}
	.corners [data-corner='fig'] {
		left: 22px;
		color: var(--text);
	}
	.corners [data-corner='title'] {
		right: 22px;
	}
	.stage {
		max-width: 880px;
		width: 100%;
		margin-inline: auto;
	}
	/* Before the drawing arrives: bare plaster with the cartoon's pounce dots. */
	.stage > :global(img:not([data-loaded])) {
		background: radial-gradient(circle, color-mix(in oklab, var(--strong) 22%, transparent) 1.1px, transparent 1.6px) 0 0 / 9px 9px;
	}
	.stage > :global(img),
	.stage > :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
	.controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		border-top: 1px solid var(--faint);
		padding-top: 18px;
	}
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
		counter-reset: s;
	}
	.compact .steps {
		display: grid;
		gap: 6px;
	}
	.steps li {
		counter-increment: s;
		color: var(--muted);
		font-size: 0.95rem;
		transition: color 300ms var(--ease);
	}
	.steps li::before {
		content: counter(s) '  ';
		font: 600 0.72rem var(--font-mono);
		white-space: pre;
	}
	.steps li[aria-current='step'] {
		color: var(--strong);
	}
	.steps li[aria-current='step']::before {
		color: var(--sanguine-ink);
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.nav button {
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--faint);
		background: var(--page);
		color: var(--strong);
		font-size: 1.3rem;
		cursor: pointer;
		transition: background-color 160ms var(--ease);
	}
	.nav button:hover {
		background: var(--card);
	}
	.readout {
		min-width: 3.5em;
		text-align: center;
		font: 0.8rem var(--font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--text);
	}
	figcaption {
		max-width: 62ch;
		font-size: 1.05rem;
		color: var(--text);
	}
	.compact figcaption {
		font-size: 0.98rem;
	}
	@media (max-width: 560px) {
		.plate {
			padding: 40px 12px 20px;
		}
	}

	/* An old-master sheet: it melts into the plate at its edges, inks in, and a warm light rests on each step. */
	@property --fx {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 50%;
	}
	@property --fy {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 50%;
	}
	@property --fr {
		syntax: '<percentage>';
		inherits: true;
		initial-value: 20%;
	}
	.drawn {
		transition:
			--fx 1100ms var(--ease),
			--fy 1100ms var(--ease),
			--fr 1100ms var(--ease);
	}
	/* The whole sheet fits one screen, with room for the plate's corners and steps. */
	.sheet {
		position: relative;
		aspect-ratio: var(--ar);
		width: min(100%, calc((100svh - 240px) * var(--ar)));
		mask:
			linear-gradient(to right, transparent, #000 3%, #000 97%, transparent),
			linear-gradient(transparent, #000 4%, #000 96%, transparent);
		mask-composite: intersect;
	}
	.ink-defs {
		position: absolute;
		width: 0;
		height: 0;
	}
	.sheet :global(picture),
	.sheet :global(img) {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* Before plate.ts starts the ink, a motion reader sees only the faint underdrawing; scripting off shows the sheet. */
	:global(html.motion) .sheet:not(.inked) :global(img) {
		filter: var(--ink);
	}
	.light {
		position: absolute;
		inset: 0;
		pointer-events: none;
		/* Outside the spot the sheet sinks a little into shade. */
		background: radial-gradient(ellipse calc(var(--fr) * 1.6) calc(var(--fr) * 1.7) at var(--fx) var(--fy), transparent 45%, color-mix(in oklab, var(--strong) 16%, transparent));
		mix-blend-mode: multiply;
		opacity: 0;
		transition: opacity 900ms var(--ease);
	}
	/* Inside it, the hero's warm gap light. */
	.light::after {
		content: '';
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse var(--fr) calc(var(--fr) * 1.07) at var(--fx) var(--fy), color-mix(in oklab, var(--gap-light) 55%, transparent), transparent 100%);
		mix-blend-mode: screen;
	}
	.drawn.lit .light {
		opacity: 1;
	}
	/* The film covers the still until it has drawn the whole sheet, then steps aside. Motion readers only. */
	.film {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: none;
	}
	:global(html.motion) .filmed:not(.inked) .film {
		display: block;
	}
	/* A filmed sheet is never inked by the filter: the film is how it is drawn. */
	:global(html.motion) .filmed :global(img) {
		filter: none;
	}
	/* Red chalk over the ink: the route between steps draws itself, and each step pens a margin note. */
	.trace {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}
	/* The tour is drawn in the sheet's own medium: red chalk on ink, white ink on blueprint, chalk on slate. */
	.sheet {
		--trace: var(--sanguine-ink);
		--trace-halo: color-mix(in oklab, var(--card) 88%, transparent);
	}
	.sheet.blueprint {
		--trace: var(--blueprint-ink);
		--trace-halo: color-mix(in oklab, var(--blueprint-ground) 85%, transparent);
	}
	.leg {
		fill: none;
		stroke: var(--trace);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		transition: stroke-dashoffset 1100ms var(--ease) 250ms;
	}
	.dot {
		fill: none;
		stroke: var(--trace);
		stroke-width: 3;
		opacity: 0;
		scale: 0.4;
		transform-box: fill-box;
		transform-origin: center;
		transition:
			opacity 400ms var(--ease) 900ms,
			scale 600ms var(--ease) 900ms;
	}
	.note {
		font: italic 400 30px var(--font-display);
		fill: var(--trace);
		/* A wash of the sheet behind the letters, so a note stays readable over hatching. */
		paint-order: stroke;
		stroke: var(--trace-halo);
		stroke-width: 9px;
		stroke-linejoin: round;
		clip-path: inset(0 100% 0 0);
		opacity: 0.4;
		transition:
			clip-path 900ms var(--ease) 1000ms,
			opacity 500ms var(--ease);
	}
	.note:global(.now) {
		opacity: 1;
	}
	:global(html:not(.motion)) .note {
		opacity: 1;
	}
	.note[text-anchor='end'] {
		clip-path: inset(0 0 0 100%);
	}
	.leg:global(.on) {
		stroke-dashoffset: 0;
	}
	.dot:global(.on) {
		opacity: 1;
		scale: 1;
	}
	.note:global(.on) {
		clip-path: inset(0 -2% 0 -2%);
	}
	/* On a dark sheet the gap light has to carry further to read. */
	.blueprint .light::after,
	.chalk .light::after {
		background: radial-gradient(ellipse var(--fr) calc(var(--fr) * 1.07) at var(--fx) var(--fy), color-mix(in oklab, var(--gap-light) 70%, transparent), transparent 100%);
	}
	/* A chalkboard writes its own labels and arrows: only the light tours it. */
	.chalk .trace {
		display: none;
	}
	/* The route and notes wait for the ink; a still reader sees them all at once. */
	:global(html.motion) .drawn:not(.lit) .trace {
		visibility: hidden;
	}
	@media (prefers-reduced-motion: reduce) {
		.leg,
		.dot,
		.note {
			transition: none;
		}
	}
	@media (max-width: 560px) {
		.note {
			font-size: 40px;
		}
	}
	.tag {
		position: absolute;
		translate: -50% -50%;
		display: grid;
		place-items: center;
		width: 22px;
		height: 22px;
		border-radius: 999px;
		background: var(--card);
		box-shadow: 0 0 0 1px var(--sanguine-ink);
		color: var(--sanguine-ink);
		font: 600 var(--t-xs) / 1 var(--font-body);
		transition:
			scale 300ms var(--ease),
			background-color 300ms var(--ease),
			color 300ms var(--ease),
			opacity 300ms var(--ease);
	}
	@media (max-width: 560px) {
		.tag {
			width: 18px;
			height: 18px;
			font-size: 0.7rem;
		}
	}
	.keyed .tag {
		opacity: 0.35;
	}
	/* A drawn sheet numbers its own parts: the tag only lights the balloon its legend entry points at. */
	.blueprint .tag,
	.chalk .tag,
	.drawn:not(.lit) .tag {
		opacity: 0;
	}
	.keyed .tag:global(.hl),
	.tag:global(.hl) {
		opacity: 1;
		scale: 1.25;
		background: var(--sanguine);
		color: var(--card);
	}
</style>
