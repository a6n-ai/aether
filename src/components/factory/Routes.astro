<!-- 1b ROUTES -->
<section class="hub" id="hub" aria-labelledby="hub-h">
  <div class="hub-head">
    <div><p class="kicker"><b>Your business, in the middle</b></p><h2 id="hub-h">Every part we build finds its way into your business.</h2></div>
    <div><p>Your website, your apps, your AI and your team's tools all arrive in one place and run on the same system. Nothing sits in a separate box.</p>
      <label for="biz">Put your business here</label><input id="biz" maxlength="26" placeholder="Your business name" autocomplete="organization"></div>
  </div>
  <div class="stage" aria-hidden="true">
    <svg class="wires"></svg>
    <div class="node" style="--c:var(--cobalt)"><i></i>Website</div>
    <div class="node" style="--c:var(--coral)"><i></i>AI assistant</div>
    <div class="node" style="--c:var(--butter)"><i></i>Customer app</div>
    <div class="node" style="--c:var(--teal)"><i></i>Your tools, connected</div>
    <div class="node" style="--c:var(--lilac)"><i></i>Team dashboard</div>
    <div class="node" style="--c:var(--coral)"><i></i>Found in ChatGPT</div>
    <div class="node" style="--c:var(--cobalt)"><i></i>Reports</div>
    <div class="node" style="--c:var(--butter)"><i></i>Staff training</div>
    <div class="core"><div><small>Your business</small><strong id="core-name">Your bakery</strong></div><div class="runs"></div><p class="runs-count" aria-hidden="true">0 of 8 parts running</p></div>
  </div>
  <ul class="vh"><li>Website</li><li>AI assistant</li><li>Customer app</li><li>Your tools, connected</li><li>Team dashboard</li><li>Found in ChatGPT and AI search</li><li>Reports</li><li>Staff training</li></ul>
</section>
