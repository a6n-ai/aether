---
import Mark from '../Mark.astro';
interface Props {
	current?: 'home' | 'factory' | 'how' | 'make' | 'showcase' | 'client';
}
const { current = 'home' } = Astro.props;
const links = [
	{ key: 'factory', href: '/factory', label: 'Factory' },
	{ key: 'how', href: '/how-it-works', label: 'How it works' },
	{ key: 'make', href: '/what-we-make', label: 'What we make' },
	{ key: 'showcase', href: '/open-source', label: 'Open source' },
];
---
<nav class="nav" aria-label="Main">
  <a class="logo" href="/" aria-label="a6n home"><Mark class="logo-mark" /><span>a6n</span></a>
  <span class="links">{links.map((l) => <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a>)}</span>
  <span class="right">
    <button class="motion-btn" type="button">Pause motion</button>
    <button class="toggle" aria-label="Light theme on. Switch to dark" aria-pressed="false">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </button>
    <a class="go" href="/#talk">Tell us what you need</a>
  </span>
</nav>
