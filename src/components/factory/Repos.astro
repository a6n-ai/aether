---
import type { Repo } from '../../data/repos';

interface Props {
	items: Repo[];
	heading?: 'h2' | 'h3';
}
const { items, heading = 'h2' } = Astro.props;
const Heading = heading;
---

<ul class="repos">
  {items.map((r) => (
    <li class="repo" style={`--c:var(${r.colour})`}>
      {r.repo && !r.site ? (
        <a class="repo-tile" href={r.repo} data-l={r.letter}>
          <span class="glyph"></span>
          <div>
            <Heading>{r.name} <span class="arr" aria-hidden="true">&#8599;</span></Heading>
            <p>{r.description}</p>
            <div class="tags">{r.tags.map((t) => <span>{t}</span>)}</div>
          </div>
        </a>
      ) : r.site ? (
        <article class="repo-tile" data-l={r.letter}>
          <span class="glyph"></span>
          <div>
            <Heading>{r.repo ? <a href={r.repo}>{r.name}</a> : r.name} <span class="arr" aria-hidden="true">&#8599;</span></Heading>
            <p>{r.description}</p>
            <div class="tags">
              {r.tags.map((t) => <span>{t}</span>)}
              <a class="site" href={r.site}>Website <span aria-hidden="true">&#8599;</span></a>
            </div>
          </div>
        </article>
      ) : (
        <article class="repo-tile" data-l={r.letter}>
          <span class="glyph"></span>
          <div>
            <Heading>{r.name}{r.soon && <span class="soon">Coming soon</span>}</Heading>
            <p>{r.description}</p>
            <div class="tags">{r.tags.map((t) => <span>{t}</span>)}</div>
          </div>
        </article>
      )}
    </li>
  ))}
</ul>
