---
import { GLYPH } from '../../scripts/factory/glyphs';
const rows = [
  { l: 'P', c: 'lilac', no: 'Plan', nm: 'Made for you', ds: 'Designed around how your business already works, not how a template thinks it should.' },
  { l: 'A', c: 'coral', no: 'AI', nm: 'AI inside', ds: 'Handles the repetitive work and answers questions from your own data.' },
  { l: 'C', c: 'teal', no: 'Connect', nm: 'Connected', ds: 'Plugs into the tools, data and accounts you already use. Your history comes with you.' },
  { l: 'G', c: 'butter', no: 'Grow', nm: 'Kept running', ds: 'The team that built it keeps it running and adds what you need next.' },
];
const dots = (l: string) => [...GLYPH[l]].flatMap((v, k) => v === '1' ? [{ x: (k % 5) * 12, y: Math.floor(k / 5) * 12 }] : []);
---
<!-- 4 INDEX -->
<section class="index" aria-labelledby="ix-h">
  <header><h2 id="ix-h">What every system gets.</h2><p>Four things come standard, whatever we build for you.</p></header>
  <ul>
    {rows.map(r => (
      <li style={`--c:var(--${r.c})`}><a href="/how-it-works"><span class="pic" aria-hidden="true"><svg viewBox="0 0 58 82">{dots(r.l).map(d => <rect x={d.x} y={d.y} width="10" height="10" rx="2.4" />)}</svg></span><span class="no">{r.no}</span><span class="nm">{r.nm}</span><span class="ds">{r.ds}</span></a></li>
    ))}
  </ul>
</section>
