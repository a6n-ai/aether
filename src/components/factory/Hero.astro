<!-- 1 HERO -->
<header class="hero">
  <div class="hero-head">
    <h1>a6n is the <em>software factory</em> for growing businesses.</h1>
    <div class="head-side"><p>You tell us what your business needs. We plan it, build it, put AI inside it and keep it running.</p><a class="go" href="/#talk">Tell us what you need</a></div>
  </div>
  <canvas class="forge" aria-hidden="true"></canvas>
  <div class="dock">
    <div class="status-row">
      <p class="forge-status" aria-live="polite"><span class="vh">The headline is built from parts. </span>On the line: <b id="forge-now">Software factory</b></p>
      <button class="chip back" type="button" hidden>&#8634; Back to software factory</button>
      <p class="hint" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 3l14 8-6 2-3 6z"/></svg>Move your cursor through the letters</p>
    </div>
    <p class="needs-lead" aria-hidden="true"><b>Try it:</b> pick a need and watch the factory build it.</p>
    <div class="needs" role="group" aria-label="Pick a need and watch the factory build it">
      <span class="needs-label"><b>Try it:</b> pick a need and watch the factory build it.</span>
      <button class="chip" style="--c:var(--butter)" data-w="DELIVERY|TRACKER" data-n="Delivery tracker" aria-pressed="false"><span class="plus" aria-hidden="true">+</span>Track every delivery</button>
      <button class="chip" style="--c:var(--coral)" data-w="AI|ASSISTANT" data-n="AI assistant" aria-pressed="false"><span class="plus" aria-hidden="true">+</span>Answer customers at 2am</button>
      <button class="chip" style="--c:var(--teal)" data-w="OWNER|DASHBOARD" data-n="Owner dashboard" aria-pressed="false"><span class="plus" aria-hidden="true">+</span>See every location</button>
      <button class="chip" style="--c:var(--lilac)" data-w="TRAINING|APP" data-n="Training app" aria-pressed="false"><span class="plus" aria-hidden="true">+</span>Train staff faster</button>
    </div>
  </div>
</header>
