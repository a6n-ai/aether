---
import Plate from './Plate.astro';
import { CAPTION as BUILD_NEW } from '../machines/build-new/geometry';
import { CAPTION as MOVE_OVER } from '../machines/move-over/geometry';
import { CAPTION as RUN_GROW } from '../machines/run-grow/geometry';
---

<section class="tracks" id="ways" data-reveal>
	<div class="wrap">
		<div data-reveal-item>
		<h2>Start where you are.</h2>
		<p class="lead">Starting fresh, moving off spreadsheets, or keeping what you have running well: pick the one that fits.</p></div>
		<div class="grid">
			<div class="track" data-reveal-item>
				<h3>Build something new</h3>
				<Plate name="build-new" fig="Plate V" title="New" caption={BUILD_NEW} compact />
			</div>
			<div class="track" data-reveal-item>
				<h3>Move you over</h3>
				<Plate name="move-over" fig="Plate VI" title="Move over" caption={MOVE_OVER} compact />
			</div>
			<div class="track" data-reveal-item>
				<h3>Run and grow</h3>
				<Plate name="run-grow" fig="Plate VII" title="Run and grow" caption={RUN_GROW} compact />
			</div>
		</div>
		<p class="more"><a href="/how-it-works/">See how a build works, step by step</a></p>
	</div>
</section>

<style>
	.tracks {
		padding-block: 88px;
	}
	h2 {
		margin-top: 12px;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.lead {
		margin-top: 12px;
		max-width: 56ch;
		font-size: 1.1rem;
	}
	.grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 20px;
	}
	.track {
		display: grid;
		align-content: start;
		gap: 14px;
	}
	h3 {
		font-size: 1.5rem;
	}
	.more {
		margin-top: 28px;
	}
	@media (max-width: 560px) {
		.tracks {
			padding-block: 56px;
		}
	}
</style>
