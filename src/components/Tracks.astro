---
import Figure from './Figure.astro';
import { CAPTION as BUILD_NEW } from '../machines/build-new/geometry';
import { CAPTION as MOVE_OVER } from '../machines/move-over/geometry';
import { CAPTION as RUN_GROW } from '../machines/run-grow/geometry';
---

<section class="tracks" id="ways" data-reveal>
	<div class="wrap">
		<div data-reveal-item>
		<h2>Start where you are.</h2>
		<p class="lead">Starting fresh, moving off spreadsheets, or keeping what you have running well: pick the one that fits.</p></div>
		<div class="grid">
			<div class="track" data-reveal-item>
				<h3>Build something new</h3>
				<Figure figure="computer" fig="Plate V" pigment="var(--lapis)" like="Like a desk computer you type on: your idea goes in, and it comes up on the screen." caption={BUILD_NEW} />
			</div>
			<div class="track" data-reveal-item>
				<h3>Move you over</h3>
				<Figure figure="hash-map" fig="Plate VI" pigment="var(--ochre)" like="Like a post-office sorting desk: every letter is stamped with its pigeonhole and filed there." caption={MOVE_OVER} />
			</div>
			<div class="track" data-reveal-item>
				<h3>Run and grow</h3>
				<Figure figure="watch" fig="Plate VII" pigment="var(--umber)" like="Like a watch movement on a bench: it keeps ticking, and we keep it tuned." caption={RUN_GROW} />
			</div>
		</div>
		<p class="more"><a href="/how-it-works/">See how a build works, step by step</a></p>
	</div>
</section>

<style>
	.tracks {
		padding-block: 88px;
	}
	h2 {
		margin-top: 12px;
		font-size: clamp(2rem, 4vw, 3rem);
	}
	.lead {
		margin-top: 12px;
		max-width: 56ch;
		font-size: 1.1rem;
	}
	.grid {
		margin-top: 40px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: 20px;
	}
	.track {
		display: grid;
		align-content: start;
		gap: 14px;
	}
	h3 {
		font-size: 1.5rem;
	}
	.more {
		margin-top: 28px;
	}
	@media (max-width: 560px) {
		.tracks {
			padding-block: 56px;
		}
	}
</style>
